<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
<head><meta charset='utf-8'><title>Báo cáo Hiệu suất FocusFlow</title>
<style>
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 30px; }
    h1 { color: #0d47a1; border-bottom: 2px solid #0d47a1; padding-bottom: 8px; font-size: 20pt; }
    h2 { color: #1565c0; margin-top: 20px; font-size: 14pt; }
    table { border-collapse: collapse; width: 100%; margin-top: 10px; }
    th, td { border: 1px solid #bbdefb; padding: 10px; text-align: left; }
    th { background-color: #e3f2fd; color: #0d47a1; }
    .box { background-color: #f5f5f5; border-left: 4px solid #1976d2; padding: 12px; margin-bottom: 15px; }
</style>
</head>
<body>
    <h1>BÁO CÁO HIỆU SUẤT HỌC TẬP FOCUSFLOW PRO</h1>
